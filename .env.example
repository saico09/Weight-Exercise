# Local development only. start-local-cloud.ps1 creates .env.local with random secrets.
POSTGRES_PASSWORD=replace-with-a-random-secret
APP_DB_PASSWORD=replace-with-another-random-secret
AUTH_SECRET=replace-with-at-least-32-random-bytes
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
# Mailpit is the safe default. Only switch after privately configuring a sender you own.
SMTP_MODE=mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=access@weight-exercise.local
PUBLIC_APP_URL=http://127.0.0.1:5173

# Google Play licensing preparation. No preview is licensed by email alone.
# Keep disabled until Play Console, signed release and private files are configured.
PRO_LICENSE_ENFORCEMENT=false
PRO_LICENSE_OFFLINE_DAYS=7
PLAY_CLOUD_PROJECT_NUMBER=
# Comma-separated base64url SHA-256 PLAY APP SIGNING certificates, not upload keys.
PLAY_CERTIFICATE_SHA256=
PLAY_MIN_VERSION_CODE=1
# Container paths to read-only mounted private files, never client assets or Git.
PLAY_SERVICE_ACCOUNT_FILE=
PRO_LICENSE_SIGNING_KEY_FILE=
